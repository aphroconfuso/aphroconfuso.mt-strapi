{
  "kind": "collectionType",
  "collectionName": "sponsorhips",
  "info": {
    "singularName": "sponsorhip",
    "pluralName": "sponsorhips",
    "displayName": "Sponsorhip"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "body": {
      "type": "text"
    },
    "logo": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": false
    },
    "stories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::story.story",
      "mappedBy": "sponsorhips"
    }
  }
}
